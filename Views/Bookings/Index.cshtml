@model IReadOnlyList<BadmintonHub.ViewModels.BookingResponseDto>
@{ ViewData["Title"] = "Lịch đặt sân"; }

<h1>Lịch đặt sân</h1>
<a class="btn btn-primary mb-3" asp-action="Create">Đặt sân mới</a>

@if (!Model.Any())
{
    <p class="text-muted">Chưa có lịch đặt sân nào. <a asp-action="Create">Đặt sân ngay</a></p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Sân</th><th>Ngày</th><th>Giờ</th><th>Trạng thái</th><th>Giá</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var b in Model)
        {
            var badgeClass = b.Status switch {
                "Pending" => "bg-warning",
                "Confirmed" => "bg-success",
                "Cancelled" => "bg-secondary",
                "Expired" => "bg-danger",
                _ => "bg-light text-dark"
            };
            <tr>
                <td>@b.CourtName</td>
                <td>@b.BookingDate.ToString("dd/MM/yyyy")</td>
                <td>@b.StartTime - @b.EndTime</td>
                <td><span class="badge @badgeClass">@b.Status</span></td>
                <td>@b.TotalPrice.ToString("N0") đ</td>
                <td>
                @if (b.Status == "Pending" || b.Status == "Confirmed")
                {
                    <form asp-action="Cancel" asp-route-id="@b.BookingId" method="post" onsubmit="return confirm('Hủy đặt sân này?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                    </form>
                }
                </td>
            </tr>
        }
        </tbody>
    </table>
}