@model IReadOnlyList<BadmintonHub.ViewModels.BookingResponseDto>
@{ var isAdmin = User.IsInRole("Admin"); ViewData["Title"] = isAdmin ? "Quản lý booking" : "Lịch đặt của tôi"; }

<section class="page-heading compact-heading">
    <div><p class="eyebrow dark"><span></span> @(isAdmin ? "ADMIN / BOOKING" : "LỊCH CỦA BẠN")</p><h1>@if (isAdmin) { <text>Điều phối mọi<br /><em>trận đấu.</em></text> } else { <text>Những trận đấu<br /><em>đang chờ bạn.</em></text> }</h1></div>
    @if (!isAdmin)
    {
        <a class="btn btn-lime" asp-action="Create">Đặt sân mới <span>↗</span></a>
    }
</section>

@if (!Model.Any())
{
    <div class="empty-state"><strong>Chưa có lịch đặt sân nào.</strong><span>Khung giờ đẹp đang chờ bạn chọn.</span><a class="text-link" asp-action="Create">Đặt sân ngay →</a></div>
}
else
{
    <div class="booking-list"><table class="booking-table">
        <thead>
            <tr><th>Sân</th><th>Ngày</th><th>Giờ</th><th>Trạng thái</th><th>Giá</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var b in Model)
        {
            var badgeClass = b.Status switch {
                "Pending" => "bg-warning",
                "Confirmed" => "bg-success",
                "Cancelled" => "bg-secondary",
                "Expired" => "bg-danger",
                _ => "bg-light text-dark"
            };
            <tr class="booking-row">
                <td><strong>@b.CourtName</strong><small>Mã đặt #@b.BookingId</small></td>
                <td><strong>@b.BookingDate.ToString("dd/MM/yyyy")</strong></td>
                <td><strong>@b.StartTime - @b.EndTime</strong></td>
                <td><span class="status-badge @badgeClass">@b.Status</span></td>
                <td><strong class="price-text">@b.TotalPrice.ToString("N0") đ</strong></td>
                <td class="booking-action">
                @if (isAdmin && b.Status == "Pending")
                {
                    <form asp-action="Confirm" asp-route-id="@b.BookingId" method="post">
                        <button type="submit" class="btn btn-sm btn-lime">Xác nhận</button>
                    </form>
                }
                @if (b.Status == "Pending" || b.Status == "Confirmed")
                {
                    <form asp-action="Cancel" asp-route-id="@b.BookingId" method="post" onsubmit="return confirm('Hủy đặt sân này?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Hủy đặt</button>
                    </form>
                }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
}