@model ErrorViewModel
@{ ViewData["Title"] = "Có lỗi xảy ra"; }

<section class="simple-state">
    <p class="eyebrow dark"><span></span> BADMINTONHUB / 500</p>
    <h1>Cú đánh này<br /><em>chưa qua lưới.</em></h1>
    <p>Hệ thống gặp một sự cố ngoài ý muốn. Hãy thử lại hoặc quay về trang chủ.</p>
    @if (Model.ShowRequestId)
    {
        <p class="request-id">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-lime" asp-controller="Home" asp-action="Index">Về trang chủ <span>↗</span></a>
</section>
