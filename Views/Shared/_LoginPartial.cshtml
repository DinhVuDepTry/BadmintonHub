@using Microsoft.AspNetCore.Identity
@using BadmintonHub.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="profile-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Quản lý tài khoản">
            <span class="avatar-dot">@(User.Identity?.Name?.Substring(0, 1).ToUpperInvariant())</span>
            <span>@User.Identity?.Name</span>
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link border-0 logout-link">Đăng xuất</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Tạo tài khoản</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-sm btn-lime nav-cta" asp-area="Identity" asp-page="/Account/Login">Đăng nhập <span>↗</span></a>
    </li>
}
</ul>