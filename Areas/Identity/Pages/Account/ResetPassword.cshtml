@page
@model BadmintonHub.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="auth-shell auth-single">
    <div class="auth-aside">
        <p class="eyebrow"><span></span> BADMINTONHUB / SECURITY</p>
        <h1>Đổi mật khẩu.<br /><em>Chơi tiếp.</em></h1>
        <p>Tạo một mật khẩu mới để bảo vệ tài khoản và lịch đặt sân của bạn.</p>
        <div class="auth-aside-mark">BH<span>↗</span></div>
    </div>
    <div class="auth-panel">
        <div class="auth-panel-head"><span>MẬT KHẨU MỚI</span><i>01 / 01</i></div>
        <h2>Đặt lại mật khẩu</h2>
        <p class="auth-muted">Chọn mật khẩu mới, tối thiểu 8 ký tự.</p>
        <form method="post" class="auth-form">
            <input asp-for="Input.Code" type="hidden" />
            <input asp-for="Input.Email" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-message"></div>
            <div class="form-field"><label asp-for="Input.Password"></label><input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Nhập mật khẩu mới" /><span asp-validation-for="Input.Password" class="field-error"></span></div>
            <div class="form-field"><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu" /><span asp-validation-for="Input.ConfirmPassword" class="field-error"></span></div>
            <button type="submit" class="btn btn-lime btn-lg form-submit">Lưu mật khẩu mới <span>↗</span></button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
