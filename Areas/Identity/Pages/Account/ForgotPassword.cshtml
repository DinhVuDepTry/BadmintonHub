@page
@model BadmintonHub.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-shell auth-single">
    <div class="auth-aside">
        <p class="eyebrow"><span></span> BADMINTONHUB / ACCOUNT</p>
        <h1>Lấy lại<br /><em>nhịp trận.</em></h1>
        <p>Nhập email đã đăng ký. Chúng tôi sẽ gửi cho bạn một liên kết để tạo mật khẩu mới.</p>
        <div class="auth-aside-mark">BH<span>↗</span></div>
    </div>
    <div class="auth-panel">
        <div class="auth-panel-head"><span>KHÔI PHỤC TÀI KHOẢN</span><i>01 / 01</i></div>
        <h2>Quên mật khẩu?</h2>
        <p class="auth-muted">Nhớ ra rồi? <a asp-page="./Login">Đăng nhập</a></p>
        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="validation-message"></div>
            <div class="form-field">
                <label asp-for="Input.Email">Email đăng ký</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-lime btn-lg form-submit">Gửi liên kết đặt lại <span>↗</span></button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
